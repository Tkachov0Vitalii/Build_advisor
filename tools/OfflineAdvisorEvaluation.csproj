<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>OfflineAdvisorEvaluation</StartupObject>
    <Sts2GameDir>C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2</Sts2GameDir>
    <Sts2ManagedDir Condition="'$(Sts2ManagedDir)' == ''">$(Sts2GameDir)\data_sts2_windows_x86_64</Sts2ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\src\*.cs" />
    <Compile Include="OfflineAdvisorEvaluation.cs" />
    <Compile Include="CalibrationFeatures.cs" />
    <None Include="..\data\build-advisor-run-priors.data" Link="build-advisor-run-priors.data" CopyToOutputDirectory="Always" />
    <None Include="..\data\segment-risk-v1.data" Link="segment-risk-v1.data" CopyToOutputDirectory="Always" />
    <None Include="..\data\score-weights-v1.data" Link="score-weights-v1.data" CopyToOutputDirectory="Always" Condition="Exists('..\data\score-weights-v1.data')" />
    <Reference Include="sts2"><HintPath>$(Sts2ManagedDir)\sts2.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(Sts2ManagedDir)\GodotSharp.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(Sts2ManagedDir)\0Harmony.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
