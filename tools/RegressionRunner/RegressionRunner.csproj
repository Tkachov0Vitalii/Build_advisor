<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs BuildAdvisorRegression outside the game:
       dotnet run (project tools/RegressionRunner, configuration Release)
       Game assemblies: tools/bin/Debug/net9.0 (copied from the game) or the Sts2ManagedDir property. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>RegressionHarness</StartupObject>
    <Sts2ManagedDir Condition="'$(Sts2ManagedDir)' == '' and Exists('$(MSBuildThisFileDirectory)../bin/Debug/net9.0/sts2.dll')">$(MSBuildThisFileDirectory)../bin/Debug/net9.0</Sts2ManagedDir>
    <Sts2ManagedDir Condition="'$(Sts2ManagedDir)' == '' and Exists('C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2\data_sts2_windows_x86_64\sts2.dll')">C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2\data_sts2_windows_x86_64</Sts2ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/*.cs" />
    <Compile Include="../RegressionHarness.cs" />
    <None Include="../../data/*.data" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="sts2"><HintPath>$(Sts2ManagedDir)/sts2.dll</HintPath></Reference>
    <Reference Include="GodotSharp"><HintPath>$(Sts2ManagedDir)/GodotSharp.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(Sts2ManagedDir)/0Harmony.dll</HintPath></Reference>
  </ItemGroup>
</Project>
